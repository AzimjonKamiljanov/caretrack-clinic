<%- include('../partials/header') %>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
  <!-- Search -->
  <div class="relative w-full sm:max-w-md">
    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted text-lg"><i data-lucide="search" class="w-5 h-5"></i></span>
    <input type="text" id="searchInput" placeholder="Bemor qidirish..." class="w-full bg-bg-card border border-border-main rounded-xl py-3 pl-11 pr-4 text-sm text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all duration-200">
  </div>
  
  <a href="/patients/create" class="flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-gold-primary to-gold-secondary text-white dark:text-black font-bold transition-all duration-300 shadow-md shadow-gold-primary/10 hover:shadow-lg hover:shadow-gold-primary/20 cursor-pointer text-sm btn-premium">
    <i data-lucide="plus" class="w-4 h-4"></i> Yangi Bemor
  </a>
</div>

<div class="glass-panel border border-border-main rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 animate-fade-in-up delay-200">
  <div class="overflow-x-auto">
    <% if (patients.length > 0) { %>
    <table class="w-full text-left floating-table">
      <thead>
        <tr class="border-b border-border-main">
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">#</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">To'liq ism</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Biriktirilgan Shifokor</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Tug'ilgan sana</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Jinsi</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Telefon</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Qon guruhi</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider text-right">Amallar</th>
        </tr>
      </thead>
      <tbody>
        <% patients.forEach((patient, index) => { %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-text-muted"><%= index + 1 %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-text-main">
            <a href="/patients/<%= patient.id %>" class="text-gold-primary hover:text-gold-secondary hover:underline">
              <%= patient.full_name %>
            </a>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <% if (patient.doctor_name) { %>
              <div class="text-sm font-semibold text-text-main"><%= patient.doctor_name %></div>
              <div class="text-xs text-text-muted"><%= patient.doctor_specialty %></div>
            <% } else { %>
              <span class="text-text-muted text-sm">—</span>
            <% } %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-text-main"><%= patient.date_of_birth || '—' %></td>
          <td class="px-6 py-4 whitespace-nowrap">
            <% if (patient.gender === 'Erkak') { %>
              <span class="px-2.5 py-0.5 rounded text-xs font-bold bg-blue-500/10 border border-blue-500/20 text-blue-600 dark:text-blue-400">Erkak</span>
            <% } else if (patient.gender === 'Ayol') { %>
              <span class="px-2.5 py-0.5 rounded text-xs font-bold bg-pink-500/10 border border-pink-500/20 text-pink-600 dark:text-pink-400">Ayol</span>
            <% } else { %>
              <span class="text-text-muted">—</span>
            <% } %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-text-main"><%= patient.phone || '—' %></td>
          <td class="px-6 py-4 whitespace-nowrap">
            <span class="bg-bg-page border border-border-main px-2 py-0.5 rounded text-xs font-bold text-gold-primary">
              <%= patient.blood_type || '—' %>
            </span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-right">
            <div class="inline-flex gap-2">
              <a href="/patients/<%= patient.id %>" class="p-2 bg-bg-page border border-border-main rounded-xl text-text-muted hover:text-gold-primary hover:border-gold-primary/40 transition-all text-sm btn-premium" title="Ko'rish">
                <i data-lucide="eye" class="w-4 h-4"></i>
              </a>
              <% if (user.role === 'admin' || user.role === 'clinician') { %>
                <a href="/patients/<%= patient.id %>/edit" class="p-2 bg-bg-page border border-border-main rounded-xl text-amber-500 hover:border-amber-500/40 hover:bg-amber-500/5 transition-all text-sm btn-premium" title="Tahrirlash">
                  <i data-lucide="edit-2" class="w-4 h-4"></i>
                </a>
              <% } %>
              <% if (user.role === 'admin') { %>
                <button class="p-2 bg-bg-page border border-border-main rounded-xl text-red-500 hover:border-red-500/40 hover:bg-red-500/5 transition-all text-sm cursor-pointer btn-premium" onclick="confirmDelete(<%= patient.id %>)" title="O'chirish">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              <% } %>
            </div>

            <!-- Delete Confirmation Modal (Admin only) -->
            <% if (user.role === 'admin') { %>
            <div class="confirm-delete text-left" id="deleteModal-<%= patient.id %>">
              <div class="modal-content">
                <h3 class="text-lg font-bold text-text-main flex items-center gap-2 mb-3">
                  <i data-lucide="alert-triangle" class="w-5 h-5"></i> O'chirishni tasdiqlang
                </h3>
                <p class="text-sm text-text-muted mb-6">
                  Haqiqatan ham bemor <strong><%= patient.full_name %></strong>ni o'chirmoqchimisiz? Ushbu bemorga bog'liq barcha tashxislar tarixi ham o'chib ketadi.
                </p>
                <div class="flex justify-end gap-3">
                  <button class="px-4 py-2.5 rounded-xl bg-bg-page border border-border-main hover:bg-bg-card-hover text-text-main font-semibold text-sm cursor-pointer btn-premium" onclick="closeModal(<%= patient.id %>)">
                    Bekor qilish
                  </button>
                  <form action="/patients/<%= patient.id %>/delete" method="POST" class="inline">
                    <button type="submit" class="px-4 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-semibold text-sm cursor-pointer btn-premium">
                      O'chirish
                    </button>
                  </form>
                </div>
              </div>
            </div>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <div class="py-16 text-center">
      <div class="text-5xl mb-4"><i data-lucide="users"></i></div>
      <h3 class="text-base font-bold text-text-muted">Bemorlar topilmadi</h3>
      <p class="text-xs text-text-muted/65 mt-1 mb-6">Tizimda hali hech qanday bemor ro'yxatdan o'tmagan.</p>
      <a href="/patients/create" class="inline-flex gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-gold-primary to-gold-secondary text-white dark:text-black font-bold transition-all duration-300 btn-premium">
        <i data-lucide="plus" class="w-4 h-4"></i> Bemor qo'shish
      </a>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
