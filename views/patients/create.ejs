<%- include('../partials/header') %>

<div class="max-w-3xl mx-auto bg-bg-card border border-border-main p-6 md:p-8 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 glow-card">
  <h3 class="text-lg font-bold text-shiny-gold uppercase tracking-wider mb-6 flex items-center gap-2 border-b border-border-main pb-4">
    <i data-lucide="users"></i> Yangi Bemor Ro'yxatga Olish
  </h3>
  
  <form method="POST" action="/patients" class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="full_name" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">
          To'liq ism <span class="text-red-500">*</span>
        </label>
        <input type="text" id="full_name" name="full_name" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" placeholder="Sardor Aliyev" required>
      </div>
      <div>
        <label for="date_of_birth" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">Tug'ilgan sana</label>
        <input type="date" id="date_of_birth" name="date_of_birth" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm [color-scheme:light] dark:[color-scheme:dark]">
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="doctor_id" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">Biriktirilgan Shifokor</label>
        <div class="relative">
          <select id="doctor_id" name="doctor_id" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm appearance-none cursor-pointer">
            <option value="" class="bg-bg-sidebar text-text-main">Shifokor tanlang</option>
            <% doctors.forEach(doc => { %>
              <option value="<%= doc.id %>" class="bg-bg-sidebar text-text-main"><%= doc.full_name %> — <%= doc.specialty %></option>
            <% }); %>
          </select>
          <span class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none text-xs">▼</span>
        </div>
      </div>
      <div>
        <label for="gender" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">Jinsi</label>
        <div class="relative">
          <select id="gender" name="gender" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm appearance-none cursor-pointer">
            <option value="" class="bg-bg-sidebar text-text-main">Tanlang</option>
            <option value="Erkak" class="bg-bg-sidebar text-text-main">Erkak</option>
            <option value="Ayol" class="bg-bg-sidebar text-text-main">Ayol</option>
          </select>
          <span class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none text-xs">▼</span>
        </div>
      </div>
      <div>
        <label for="blood_type" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">Qon guruhi</label>
        <div class="relative">
          <select id="blood_type" name="blood_type" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm appearance-none cursor-pointer">
            <option value="" class="bg-bg-sidebar text-text-main">Tanlang</option>
            <option value="A+" class="bg-bg-sidebar text-text-main">A+</option>
            <option value="A-" class="bg-bg-sidebar text-text-main">A-</option>
            <option value="B+" class="bg-bg-sidebar text-text-main">B+</option>
            <option value="B-" class="bg-bg-sidebar text-text-main">B-</option>
            <option value="AB+" class="bg-bg-sidebar text-text-main">AB+</option>
            <option value="AB-" class="bg-bg-sidebar text-text-main">AB-</option>
            <option value="O+" class="bg-bg-sidebar text-text-main">O+</option>
            <option value="O-" class="bg-bg-sidebar text-text-main">O-</option>
          </select>
          <span class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none text-xs">▼</span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="phone" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">Telefon raqami</label>
        <input type="text" id="phone" name="phone" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" placeholder="+998931112233">
      </div>
      <div>
        <label for="emergency_contact" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">Favqulodda aloqa raqami</label>
        <input type="text" id="emergency_contact" name="emergency_contact" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" placeholder="+998931112234">
      </div>
    </div>

    <div>
      <label for="address" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">Manzil</label>
      <textarea id="address" name="address" rows="3" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" placeholder="Toshkent, Chilonzor tumani..."></textarea>
    </div>

    <div class="flex items-center gap-3 pt-4 border-t border-border-main">
      <button type="submit" class="px-6 py-3 rounded-xl bg-[var(--gold-primary)] font-bold transition-all duration-300 shadow-md shadow-gold-primary/10 hover:shadow-lg hover:shadow-gold-primary/20 cursor-pointer text-sm btn-premium">
        💾 Saqlash
      </button>
      <a href="/patients" class="px-6 py-3 rounded-xl bg-bg-page border border-border-main hover:bg-bg-card-hover text-text-main font-semibold transition-all text-sm cursor-pointer btn-premium">
        Bekor qilish
      </a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
