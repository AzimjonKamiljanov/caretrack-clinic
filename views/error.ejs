<%# CareTrack Clinic — Xato sahifasi %>
<%# Login qilmagan va login qilgan foydalanuvchi uchun to'g'ri ishlaydi %>

<%- include('partials/header') %>

<% if (!user) { %>
<%# Login qilmagan foydalanuvchi uchun — to'liq HTML sahifa %>
<div class="min-h-screen flex items-center justify-center p-4 relative z-10">
<% } %>

<div class="max-w-md mx-auto bg-bg-card border border-border-main p-8 rounded-2xl shadow-lg text-center glow-card">
  <div class="inline-flex w-16 h-16 rounded-2xl bg-amber-500/10 items-center justify-center text-4xl mb-4 shadow-md shadow-amber-500/5">
    <i data-lucide="alert-triangle" class="w-8 h-8 text-amber-500"></i>
  </div>
  <h2 class="text-xl font-bold text-text-main mb-2"><%= title %></h2>
  <p class="text-sm text-text-muted mb-6"><%= message %></p>
  <% if (user) { %>
    <%# Kirgan foydalanuvchi — Dashboard ga yo'naltirish %>
    <a href="/dashboard" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[var(--gold-primary)] font-bold transition-all duration-300 shadow-md shadow-gold-primary/10 cursor-pointer text-sm btn-premium">
      🏠 Boshqaruv paneliga qaytish
    </a>
  <% } else { %>
    <%# Kirmagan foydalanuvchi — Login ga yo'naltirish %>
    <a href="/login" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[var(--gold-primary)] font-bold transition-all duration-300 shadow-md shadow-gold-primary/10 cursor-pointer text-sm btn-premium">
      🔑 Kirish sahifasiga o'tish
    </a>
  <% } %>
</div>

<% if (!user) { %>
</div>
<% } %>

<%- include('partials/footer') %>
