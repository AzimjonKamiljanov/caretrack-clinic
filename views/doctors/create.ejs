<%- include('../partials/header') %>

<div class="max-w-3xl mx-auto bg-bg-card border border-border-main p-6 md:p-8 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 glow-card">
  <h3 class="text-lg font-bold text-shiny-gold uppercase tracking-wider mb-6 flex items-center gap-2 border-b border-border-main pb-4">
    <i data-lucide="stethoscope"></i> Yangi Shifokor Qo'shish
  </h3>
  
  <form method="POST" action="/doctors" class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="full_name" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">
          To'liq ism <span class="text-red-500">*</span>
        </label>
        <input type="text" id="full_name" name="full_name" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" placeholder="Dr. Aziz Karimov" required>
      </div>
      <div>
        <label for="specialty" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">
          Mutaxassislik <span class="text-red-500">*</span>
        </label>
        <input type="text" id="specialty" name="specialty" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" placeholder="Terapevt, Kardiolog..." required>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="phone" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">Telefon raqami</label>
        <input type="text" id="phone" name="phone" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" placeholder="+998901234567">
      </div>
      <div>
        <label for="email" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">Email</label>
        <input type="email" id="email" name="email" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" placeholder="shifokor@caretrack.uz">
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="experience_years" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">Tajriba (yil)</label>
        <input type="number" id="experience_years" name="experience_years" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" placeholder="0" min="0">
      </div>
      <div></div>
    </div>

    <div>
      <label for="bio" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">Qisqacha ma'lumot</label>
      <textarea id="bio" name="bio" rows="4" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" placeholder="Shifokor haqida qisqacha ma'lumot kiriting..."></textarea>
    </div>

    <div class="flex items-center gap-3 pt-4 border-t border-border-main">
      <button type="submit" class="px-6 py-3 rounded-xl bg-[var(--gold-primary)] font-bold transition-all duration-300 shadow-md shadow-gold-primary/10 hover:shadow-lg hover:shadow-gold-primary/20 cursor-pointer text-sm btn-premium">
        💾 Saqlash
      </button>
      <a href="/doctors" class="px-6 py-3 rounded-xl bg-bg-page border border-border-main hover:bg-bg-card-hover text-text-main font-semibold transition-all text-sm cursor-pointer btn-premium">
        Bekor qilish
      </a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
