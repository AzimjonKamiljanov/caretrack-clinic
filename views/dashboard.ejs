<%- include('partials/header') %>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <!-- Stat Card: Doctors -->
    <div
      class="dash-card glass-panel border border-border-main p-5 rounded-2xl flex items-center gap-4 transition-all duration-300 shadow-sm hover:shadow-md glow-card group animate-fade-in-up delay-100">
      <div
        class="icon-wrapper-large bg-gold-primary/10 text-gold-primary group-hover:bg-gold-primary/20 transition-all duration-300">
        <i data-lucide="stethoscope"></i>
      </div>
      <div>
        <h3 class="text-2xl font-black text-text-main">
          <%= stats.doctors %>
        </h3>
        <p class="text-xs font-bold text-text-muted uppercase tracking-wider">Shifokorlar</p>
      </div>
    </div>

    <!-- Stat Card: Patients -->
    <div
      class="dash-card glass-panel border border-border-main p-5 rounded-2xl flex items-center gap-4 transition-all duration-300 shadow-sm hover:shadow-md glow-card group animate-fade-in-up delay-100">
      <div
        class="icon-wrapper-large bg-gold-primary/10 text-gold-primary group-hover:bg-gold-primary/20 transition-all duration-300">
        <i data-lucide="users"></i>
      </div>
      <div>
        <h3 class="text-2xl font-black text-text-main">
          <%= stats.patients %>
        </h3>
        <p class="text-xs font-bold text-text-muted uppercase tracking-wider">Bemorlar</p>
      </div>
    </div>

    <!-- Stat Card: Illnesses -->
    <div
      class="dash-card glass-panel border border-border-main p-5 rounded-2xl flex items-center gap-4 transition-all duration-300 shadow-sm hover:shadow-md glow-card group animate-fade-in-up delay-200">
      <div
        class="icon-wrapper-large bg-gold-primary/10 text-gold-primary group-hover:bg-gold-primary/20 transition-all duration-300">
        <i data-lucide="clipboard-list"></i>
      </div>
      <div>
        <h3 class="text-2xl font-black text-text-main">
          <%= stats.illnesses %>
        </h3>
        <p class="text-xs font-bold text-text-muted uppercase tracking-wider">Tashxislar</p>
      </div>
    </div>

    <!-- Stat Card: Active Illnesses -->
    <div
      class="dash-card glass-panel border border-border-main p-5 rounded-2xl flex items-center gap-4 transition-all duration-300 shadow-sm hover:shadow-md glow-card group animate-fade-in-up delay-200">
      <div class="icon-wrapper-large bg-red-500/10 text-red-500 group-hover:bg-red-500/20 transition-all duration-300">
        <i data-lucide="alert-triangle" class="w-5 h-5"></i>
      </div>
      <div>
        <h3 class="text-2xl font-black text-red-500">
          <%= stats.activeIllnesses %>
        </h3>
        <p class="text-xs font-bold text-text-muted uppercase tracking-wider">Faol kasalliklar</p>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="glass-panel border border-border-main p-6 rounded-2xl mb-8 animate-fade-in-up delay-300">
    <h3 class="text-sm font-bold text-shiny-gold uppercase tracking-wider mb-4 flex items-center gap-2">
      ⚡ Tezkor Amallar
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a href="/doctors/create"
        class="flex items-center justify-center gap-2 px-5 py-4 rounded-xl bg-bg-page border border-gold-primary/25 text-gold-primary font-bold hover:bg-gradient-to-r hover:from-gold-primary hover:to-gold-secondary hover:text-white dark:hover:text-black hover:border-transparent transition-all duration-300 shadow-sm hover:shadow-md hover:shadow-gold-primary/10 cursor-pointer btn-premium text-sm">
        <i data-lucide="plus" class="w-4 h-4"></i> Yangi Shifokor
      </a>
      <a href="/patients/create"
        class="flex items-center justify-center gap-2 px-5 py-4 rounded-xl bg-bg-page border border-gold-primary/25 text-gold-primary font-bold hover:bg-gradient-to-r hover:from-gold-primary hover:to-gold-secondary hover:text-white dark:hover:text-black hover:border-transparent transition-all duration-300 shadow-sm hover:shadow-md hover:shadow-gold-primary/10 cursor-pointer btn-premium text-sm">
        <i data-lucide="plus" class="w-4 h-4"></i> Yangi Bemor
      </a>
      <a href="/illnesses/create"
        class="flex items-center justify-center gap-2 px-5 py-4 rounded-xl bg-bg-page border border-gold-primary/25 text-gold-primary font-bold hover:bg-gradient-to-r hover:from-gold-primary hover:to-gold-secondary hover:text-white dark:hover:text-black hover:border-transparent transition-all duration-300 shadow-sm hover:shadow-md hover:shadow-gold-primary/10 cursor-pointer btn-premium text-sm">
        <i data-lucide="plus" class="w-4 h-4"></i> Yangi Tashxis
      </a>
    </div>
  </div>

  <!-- Recent Illnesses -->
  <div
    class="glass-panel border border-border-main rounded-2xl overflow-hidden shadow-sm hover:shadow-md mb-8 transition-all duration-300 animate-fade-in-up delay-400">
    <div class="px-6 py-5 border-b border-border-main flex items-center justify-between flex-wrap gap-4">
      <h3 class="text-base font-bold text-text-main flex items-center gap-2">
        <i data-lucide="clipboard-list"></i> So'nggi Tashxislar
      </h3>
      <a href="/illnesses"
        class="text-xs font-bold text-gold-primary hover:text-gold-secondary transition-colors flex items-center gap-1">
        Barchasini ko'rish <span class="text-sm">→</span>
      </a>
    </div>

    <div class="overflow-x-auto">
      <% if (recentIllnesses.length> 0) { %>
        <table class="w-full text-left floating-table">
          <thead>
            <tr class="border-b border-border-main">
              <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Bemor</th>
              <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Shifokor</th>
              <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Tashxis</th>
              <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Holat</th>
              <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Sana</th>
            </tr>
          </thead>
          <tbody>
            <% recentIllnesses.forEach(illness=> { %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="text-sm font-bold text-text-main">
                    <%= illness.patient_name %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-text-main">
                  <%= illness.doctor_name %>
                </td>
                <td class="px-6 py-4 text-sm text-text-main">
                  <span
                    class="bg-bg-page border border-border-main px-2.5 py-1 rounded-md text-xs font-semibold text-gold-primary">
                    <%= illness.diagnosis %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if (illness.status==='Faol' ) { %>
                    <span
                      class="px-2.5 py-1 rounded-full text-xs font-bold bg-[var(--badge-faol-bg)] border border-[var(--badge-faol-border)] text-[var(--badge-faol-text)]"><span
                        class="pulse-dot pulse-red mr-1"></span> Faol</span>
                    <% } else if (illness.status==='Davolanmoqda' ) { %>
                      <span
                        class="px-2.5 py-1 rounded-full text-xs font-bold bg-[var(--badge-dav-bg)] border border-[var(--badge-dav-border)] text-[var(--badge-dav-text)]"><span
                          class="pulse-dot pulse-amber mr-1"></span> Davolanmoqda</span>
                      <% } else { %>
                        <span
                          class="px-2.5 py-1 rounded-full text-xs font-bold bg-[var(--badge-tuz-bg)] border border-[var(--badge-tuz-border)] text-[var(--badge-tuz-text)]"><span
                            class="pulse-dot pulse-emerald mr-1"></span> Tuzalgan</span>
                        <% } %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-xs text-text-muted">
                  <%= illness.diagnosed_date %>
                </td>
              </tr>
              <% }); %>
          </tbody>
        </table>
        <% } else { %>
          <div class="py-12 text-center">
            <div class="text-4xl mb-3"><i data-lucide="clipboard-list"></i></div>
            <h3 class="text-sm font-bold text-text-muted">Tashxislar yo'q</h3>
            <p class="text-xs text-text-muted/65 mt-1">Hali hech qanday tashxis kiritilmagan</p>
          </div>
          <% } %>
    </div>
  </div>

  <!-- Health Tips / News Feed (Axios Integration) -->
  <div class="glass-panel border border-border-main p-6 rounded-2xl mb-8 animate-fade-in-up delay-300">
    <h3 class="text-sm font-bold text-shiny-gold uppercase tracking-wider mb-4 flex items-center gap-2">
      📰 Dunyo Tibbiyot Yangiliklari (Axios orqali olingan)
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <% healthTips.forEach(tip=> { %>
        <div
          class="p-4 rounded-xl border border-border-main bg-bg-page hover:border-gold-primary/50 transition-all duration-300">
          <h4 class="text-sm font-bold text-text-main capitalize mb-2">
            <%= tip.title %>
          </h4>
          <p class="text-xs text-text-muted leading-relaxed capitalize">
            <%= tip.body %>
          </p>
        </div>
        <% }) %>
    </div>
  </div>

  <!-- Visualizations -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-8">
    <!-- Status Chart -->
    <div class="glass-panel border border-border-main p-5 rounded-2xl animate-fade-in-up delay-400">
      <h3 class="text-sm font-bold text-text-main uppercase tracking-wider mb-4 flex items-center gap-2">
        <i data-lucide="pie-chart"></i> Kasallik Holati
      </h3>
      <div id="statusChart" class="w-full flex justify-center"></div>
    </div>

    <!-- Gender Chart -->
    <div class="glass-panel border border-border-main p-5 rounded-2xl animate-fade-in-up delay-400">
      <h3 class="text-sm font-bold text-text-main uppercase tracking-wider mb-4 flex items-center gap-2">
        <i data-lucide="users"></i> Bemorlar Jinsi
      </h3>
      <div id="genderChart" class="w-full flex justify-center"></div>
    </div>

    <!-- Age Chart -->
    <div class="glass-panel border border-border-main p-5 rounded-2xl animate-fade-in-up delay-500">
      <h3 class="text-sm font-bold text-text-main uppercase tracking-wider mb-4 flex items-center gap-2">
        <i data-lucide="bar-chart-2"></i> Bemorlar Yoshi
      </h3>
      <div id="ageChart" class="w-full"></div>
    </div>

    <!-- Doctor Workload Chart -->
    <div class="glass-panel border border-border-main p-5 rounded-2xl animate-fade-in-up delay-500">
      <h3 class="text-sm font-bold text-text-main uppercase tracking-wider mb-4 flex items-center gap-2">
        <i data-lucide="activity"></i> Shifokorlar Ish Yuklamasi
      </h3>
      <div id="doctorChart" class="w-full"></div>
    </div>
  </div>

  <script id="chart-data-status" type="application/json"><%- JSON.stringify(statusStats || []) %></script>
  <script id="chart-data-gender" type="application/json"><%- JSON.stringify(genderStats || []) %></script>
  <script id="chart-data-age" type="application/json"><%- JSON.stringify(ageStats || {}) %></script>
  <script id="chart-data-doctor" type="application/json"><%- JSON.stringify(doctorWorkload || []) %></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const isDark = document.documentElement.classList.contains('dark');
      const textColor = isDark ? '#9ca3af' : '#4b5563';

      // Status Donut Chart
      const statusStats = JSON.parse(document.getElementById('chart-data-status').textContent || '[]');
      if (statusStats.length > 0) {
        const statusLabels = statusStats.map(s => s.status);
        const statusSeries = statusStats.map(s => s.count);
        const statusColors = statusLabels.map(l => l === 'Faol' ? '#ef4444' : l === 'Davolanmoqda' ? '#f59e0b' : '#10b981');

        new ApexCharts(document.querySelector("#statusChart"), {
          series: statusSeries,
          labels: statusLabels,
          chart: { type: 'donut', height: 280, background: 'transparent' },
          colors: statusColors,
          theme: { mode: isDark ? 'dark' : 'light' },
          stroke: { show: true, colors: 'transparent' },
          dataLabels: { enabled: false },
          legend: { position: 'bottom', labels: { colors: textColor } }
        }).render();
      }

      // Gender Pie Chart
      const genderStats = JSON.parse(document.getElementById('chart-data-gender').textContent || '[]');
      if (genderStats.length > 0) {
        new ApexCharts(document.querySelector("#genderChart"), {
          series: genderStats.map(s => s.count),
          labels: genderStats.map(s => s.gender),
          chart: { type: 'pie', height: 280, background: 'transparent' },
          colors: ['#3b82f6', '#ec4899'],
          theme: { mode: isDark ? 'dark' : 'light' },
          stroke: { show: true, colors: 'transparent' },
          dataLabels: { enabled: false },
          legend: { position: 'bottom', labels: { colors: textColor } }
        }).render();
      }

      // Age Bar Chart
      const ageStats = JSON.parse(document.getElementById('chart-data-age').textContent || '{}');
      if (Object.keys(ageStats).length > 0) {
        new ApexCharts(document.querySelector("#ageChart"), {
          series: [{ name: 'Bemorlar', data: Object.values(ageStats) }],
          chart: { type: 'bar', height: 280, background: 'transparent', toolbar: { show: false } },
          plotOptions: { bar: { borderRadius: 6, horizontal: false, columnWidth: '40%' } },
          xaxis: { categories: Object.keys(ageStats), labels: { style: { colors: textColor } } },
          yaxis: { labels: { style: { colors: textColor } } },
          colors: ['#DAB546'],
          theme: { mode: isDark ? 'dark' : 'light' },
          dataLabels: { enabled: false },
          grid: { borderColor: isDark ? '#374151' : '#e5e7eb', strokeDashArray: 4 }
        }).render();
      }

      // Doctor Workload Bar Chart
      const doctorWorkload = JSON.parse(document.getElementById('chart-data-doctor').textContent || '[]');
      if (doctorWorkload.length > 0) {
        new ApexCharts(document.querySelector("#doctorChart"), {
          series: [{ name: 'Bemorlar soni', data: doctorWorkload.map(d => d.patient_count) }],
          chart: { type: 'bar', height: 280, background: 'transparent', toolbar: { show: false } },
          plotOptions: { bar: { borderRadius: 4, horizontal: true } },
          xaxis: { categories: doctorWorkload.map(d => d.doctor_name), labels: { style: { colors: textColor } } },
          yaxis: { labels: { style: { colors: textColor } } },
          colors: ['#10b981'],
          theme: { mode: isDark ? 'dark' : 'light' },
          dataLabels: { enabled: true, style: { colors: ['#fff'] } },
          grid: { borderColor: isDark ? '#374151' : '#e5e7eb', strokeDashArray: 4 }
        }).render();
      }
    });
  </script>

  <%- include('partials/footer') %>