<%- include('../partials/header') %>

<div class="max-w-3xl mx-auto bg-bg-card border border-border-main p-6 md:p-8 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 glow-card">
  <h3 class="text-lg font-bold text-shiny-gold uppercase tracking-wider mb-6 flex items-center gap-2 border-b border-border-main pb-4">
    👤 Yangi Foydalanuvchi Yaratish
  </h3>
  
  <form method="POST" action="/users" class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="full_name" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">
          To'liq ism <span class="text-red-500">*</span>
        </label>
        <input type="text" id="full_name" name="full_name" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" placeholder="Jasur Abdullayev" required>
      </div>
      
      <div>
        <label for="username" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">
          Username <span class="text-red-500">*</span>
        </label>
        <input type="text" id="username" name="username" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" placeholder="jasur_admin" required>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="password" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">
          Parol <span class="text-red-500">*</span>
        </label>
        <input type="password" id="password" name="password" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" placeholder="••••••••" required>
      </div>
      
      <div>
        <label for="role" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">
          Rol <span class="text-red-500">*</span>
        </label>
        <div class="relative">
          <select id="role" name="role" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm appearance-none cursor-pointer" required>
            <option value="" class="bg-bg-sidebar text-text-main">Rolni tanlang</option>
            <option value="admin" class="bg-bg-sidebar text-text-main">Administrator</option>
            <option value="clinician" class="bg-bg-sidebar text-text-main">Klinitsist</option>
            <option value="receptionist" class="bg-bg-sidebar text-text-main">Qabulxona</option>
          </select>
          <span class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none text-xs">▼</span>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-3 pt-4 border-t border-border-main">
      <button type="submit" class="px-6 py-3 rounded-xl bg-[var(--gold-primary)] font-bold transition-all duration-300 shadow-md shadow-gold-primary/10 hover:shadow-lg hover:shadow-gold-primary/20 cursor-pointer text-sm btn-premium">
        💾 Yaratish
      </button>
      <a href="/users" class="px-6 py-3 rounded-xl bg-bg-page border border-border-main hover:bg-bg-card-hover text-text-main font-semibold transition-all text-sm cursor-pointer btn-premium">
        Bekor qilish
      </a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
