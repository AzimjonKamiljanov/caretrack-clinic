<%- include('../partials/header') %>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
  <!-- Search -->
  <div class="relative w-full sm:max-w-md">
    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted text-lg"><i data-lucide="search" class="w-5 h-5"></i></span>
    <input type="text" id="searchInput" placeholder="Foydalanuvchi qidirish..." class="w-full bg-bg-card border border-border-main rounded-xl py-3 pl-11 pr-4 text-sm text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all duration-200">
  </div>
  
  <a href="/users/create" class="flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-gold-primary to-gold-secondary text-white dark:text-black font-bold transition-all duration-300 shadow-md shadow-gold-primary/10 hover:shadow-lg hover:shadow-gold-primary/20 cursor-pointer text-sm btn-premium">
    <i data-lucide="plus" class="w-4 h-4"></i> Yangi Foydalanuvchi
  </a>
</div>

<div class="glass-panel border border-border-main rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 animate-fade-in-up delay-200">
  <div class="overflow-x-auto">
    <% if (users.length > 0) { %>
    <table class="w-full text-left floating-table">
      <thead>
        <tr class="border-b border-border-main">
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">#</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Username</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">To'liq ism</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Rol</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Yaratilgan</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider text-right">Amallar</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach((u, index) => { %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-text-muted"><%= index + 1 %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-text-main">
            <span class="bg-bg-page border border-border-main px-2.5 py-1 rounded text-xs font-bold text-gold-primary">
              <%= u.username %>
            </span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-text-main"><%= u.full_name %></td>
          <td class="px-6 py-4 whitespace-nowrap">
            <% if (u.role === 'admin') { %>
              <span class="px-2.5 py-0.5 rounded text-xs font-bold bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400">Administrator</span>
            <% } else if (u.role === 'clinician') { %>
              <span class="px-2.5 py-0.5 rounded text-xs font-bold bg-purple-500/10 border border-purple-500/20 text-purple-600 dark:text-purple-400">Klinitsist</span>
            <% } else { %>
              <span class="px-2.5 py-0.5 rounded text-xs font-bold bg-blue-500/10 border border-blue-500/20 text-blue-600 dark:text-blue-400">Qabulxona</span>
            <% } %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-xs text-text-muted"><%= u.created_at %></td>
          <td class="px-6 py-4 whitespace-nowrap text-right">
            <div class="inline-flex gap-2">
              <a href="/users/<%= u.id %>/edit" class="p-2 bg-bg-page border border-border-main rounded-xl text-amber-500 hover:border-amber-500/40 hover:bg-amber-500/5 transition-all text-sm btn-premium" title="Tahrirlash">
                <i data-lucide="edit-2" class="w-4 h-4"></i>
              </a>
              <% if (u.id !== user.id) { %>
                <button class="p-2 bg-bg-page border border-border-main rounded-xl text-red-500 hover:border-red-500/40 hover:bg-red-500/5 transition-all text-sm cursor-pointer btn-premium" onclick="confirmDelete(<%= u.id %>)" title="O'chirish">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              <% } %>
            </div>

            <!-- Delete Confirmation Modal (Admin only) -->
            <% if (u.id !== user.id) { %>
            <div class="confirm-delete text-left" id="deleteModal-<%= u.id %>">
              <div class="modal-content">
                <h3 class="text-lg font-bold text-text-main flex items-center gap-2 mb-3">
                  <i data-lucide="alert-triangle" class="w-5 h-5"></i> O'chirishni tasdiqlang
                </h3>
                <p class="text-sm text-text-muted mb-6">
                  Haqiqatan ham foydalanuvchi <strong><%= u.full_name %></strong>ni o'chirmoqchimisiz?
                </p>
                <div class="flex justify-end gap-3">
                  <button class="px-4 py-2.5 rounded-xl bg-bg-page border border-border-main hover:bg-bg-card-hover text-text-main font-semibold text-sm cursor-pointer btn-premium" onclick="closeModal(<%= u.id %>)">
                    Bekor qilish
                  </button>
                  <form action="/users/<%= u.id %>/delete" method="POST" class="inline">
                    <button type="submit" class="px-4 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-semibold text-sm cursor-pointer btn-premium">
                      O'chirish
                    </button>
                  </form>
                </div>
              </div>
            </div>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <div class="py-16 text-center">
      <div class="text-5xl mb-4"><i data-lucide="users"></i></div>
      <h3 class="text-base font-bold text-text-muted">Foydalanuvchilar yo'q</h3>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
