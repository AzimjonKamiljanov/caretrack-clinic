<%- include('../partials/header') %>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
  <!-- Search -->
  <div class="relative w-full sm:max-w-md">
    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-text-muted text-lg"><i data-lucide="search" class="w-5 h-5"></i></span>
    <input type="text" id="searchInput" placeholder="Tashxis qidirish..." class="w-full bg-bg-card border border-border-main rounded-xl py-3 pl-11 pr-4 text-sm text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all duration-200">
  </div>
  
  <% if (user.role === 'admin' || user.role === 'clinician') { %>
    <a href="/illnesses/create" class="flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[var(--gold-primary)] font-bold transition-all duration-300 shadow-md shadow-gold-primary/10 hover:shadow-lg hover:shadow-gold-primary/20 cursor-pointer text-sm btn-premium">
      <i data-lucide="plus" class="w-4 h-4"></i> Yangi Tashxis
    </a>
  <% } %>
</div>

<div class="glass-panel border border-border-main rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 animate-fade-in-up delay-200">
  <div class="overflow-x-auto">
    <% if (illnesses.length > 0) { %>
    <table class="w-full text-left floating-table">
      <thead>
        <tr class="border-b border-border-main">
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">#</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Bemor</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Shifokor</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Tashxis</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Dorilar / Muolajalar</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Holat</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider">Sana</th>
          <th class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider text-right">Amallar</th>
        </tr>
      </thead>
      <tbody>
        <% illnesses.forEach((illness, index) => { %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-text-muted"><%= index + 1 %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-text-main">
            <a href="/patients/<%= illness.patient_id %>" class="text-gold-primary hover:text-gold-secondary hover:underline">
              <%= illness.patient_name %>
            </a>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-text-main">
            <div><%= illness.doctor_name %></div>
            <div class="text-xs text-text-muted font-semibold"><%= illness.doctor_specialty %></div>
          </td>
          <td class="px-6 py-4 text-sm font-bold text-text-main">
            <span class="bg-bg-page border border-border-main px-2.5 py-1 rounded text-xs text-gold-primary font-semibold">
              <%= illness.diagnosis %>
            </span>
          </td>
          <td class="px-6 py-4 text-sm text-text-main max-w-xs truncate"><%= illness.prescribed_meds || '—' %></td>
          <td class="px-6 py-4 whitespace-nowrap">
            <% if (illness.status === 'Faol') { %>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-[var(--badge-faol-bg)] border border-[var(--badge-faol-border)] text-[var(--badge-faol-text)]"><span class="pulse-dot pulse-red mr-1"></span> Faol</span>
            <% } else if (illness.status === 'Davolanmoqda') { %>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-[var(--badge-dav-bg)] border border-[var(--badge-dav-border)] text-[var(--badge-dav-text)]"><span class="pulse-dot pulse-amber mr-1"></span> Davolanmoqda</span>
            <% } else { %>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-[var(--badge-tuz-bg)] border border-[var(--badge-tuz-border)] text-[var(--badge-tuz-text)]"><span class="pulse-dot pulse-emerald mr-1"></span> Tuzalgan</span>
            <% } %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-xs text-text-muted"><%= illness.diagnosed_date %></td>
          <td class="px-6 py-4 whitespace-nowrap text-right">
            <div class="inline-flex gap-2">
              <% if (user.role === 'admin' || user.role === 'clinician') { %>
                <a href="/illnesses/<%= illness.id %>/edit" class="p-2 bg-bg-page border border-border-main rounded-xl text-amber-500 hover:border-amber-500/40 hover:bg-amber-500/5 transition-all text-sm btn-premium" title="Tahrirlash">
                  <i data-lucide="edit-2" class="w-4 h-4"></i>
                </a>
              <% } %>
              <% if (user.role === 'admin') { %>
                <button class="p-2 bg-bg-page border border-border-main rounded-xl text-red-500 hover:border-red-500/40 hover:bg-red-500/5 transition-all text-sm cursor-pointer btn-premium" onclick="confirmDelete(<%= illness.id %>)" title="O'chirish">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              <% } %>
            </div>

            <!-- Delete Confirmation Modal (Admin only) -->
            <% if (user.role === 'admin') { %>
            <div class="confirm-delete text-left" id="deleteModal-<%= illness.id %>">
              <div class="modal-content">
                <h3 class="text-lg font-bold text-text-main flex items-center gap-2 mb-3">
                  <i data-lucide="alert-triangle" class="w-5 h-5"></i> O'chirishni tasdiqlang
                </h3>
                <p class="text-sm text-text-muted mb-6">
                  Haqiqatan ham <strong><%= illness.patient_name %></strong>ga qo'yilgan <strong><%= illness.diagnosis %></strong> tashxisini o'chirmoqchimisiz?
                </p>
                <div class="flex justify-end gap-3">
                  <button class="px-4 py-2.5 rounded-xl bg-bg-page border border-border-main hover:bg-bg-card-hover text-text-main font-semibold text-sm cursor-pointer btn-premium" onclick="closeModal(<%= illness.id %>)">
                    Bekor qilish
                  </button>
                  <form action="/illnesses/<%= illness.id %>/delete" method="POST" class="inline">
                    <button type="submit" class="px-4 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-semibold text-sm cursor-pointer btn-premium">
                      O'chirish
                    </button>
                  </form>
                </div>
              </div>
            </div>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <div class="py-16 text-center">
      <div class="text-5xl mb-4"><i data-lucide="clipboard-list"></i></div>
      <h3 class="text-base font-bold text-text-muted">Tashxislar topilmadi</h3>
      <p class="text-xs text-text-muted/65 mt-1 mb-6">Hali hech qanday tashxis kiritilmagan.</p>
      <% if (user.role === 'admin' || user.role === 'clinician') { %>
        <a href="/illnesses/create" class="inline-flex gap-2 px-5 py-3 rounded-xl bg-[var(--gold-primary)] font-bold transition-all duration-300 btn-premium">
          <i data-lucide="plus" class="w-4 h-4"></i> Yangi tashxis qo'shish
        </a>
      <% } %>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
