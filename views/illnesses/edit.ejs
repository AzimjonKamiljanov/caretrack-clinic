<%- include('../partials/header') %>

<div class="max-w-3xl mx-auto bg-bg-card border border-border-main p-6 md:p-8 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 glow-card">
  <h3 class="text-lg font-bold text-shiny-gold uppercase tracking-wider mb-6 flex items-center gap-2 border-b border-border-main pb-4">
    <i data-lucide="edit-2" class="w-4 h-4"></i> Tashxisni Tahrirlash
  </h3>
  
  <form method="POST" action="/illnesses/<%= illness.id %>" class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="patient_id" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">
          Bemor <span class="text-red-500">*</span>
        </label>
        <div class="relative">
          <select id="patient_id" name="patient_id" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm appearance-none cursor-pointer" required>
            <% patients.forEach(p => { %>
              <option value="<%= p.id %>" class="bg-bg-sidebar text-text-main" <%= illness.patient_id === p.id ? 'selected' : '' %>><%= p.full_name %></option>
            <% }); %>
          </select>
          <span class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none text-xs">▼</span>
        </div>
      </div>
      
      <div>
        <label for="doctor_id" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">
          Shifokor <span class="text-red-500">*</span>
        </label>
        <div class="relative">
          <select id="doctor_id" name="doctor_id" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm appearance-none cursor-pointer" required>
            <% doctors.forEach(d => { %>
              <option value="<%= d.id %>" class="bg-bg-sidebar text-text-main" <%= illness.doctor_id === d.id ? 'selected' : '' %>><%= d.full_name %> (<%= d.specialty %>)</option>
            <% }); %>
          </select>
          <span class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none text-xs">▼</span>
        </div>
      </div>
    </div>

    <div>
      <label for="diagnosis" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">
        Tashxis <span class="text-red-500">*</span>
      </label>
      <input type="text" id="diagnosis" name="diagnosis" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" value="<%= illness.diagnosis %>" required>
    </div>

    <div>
      <label for="description" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">Tavsif</label>
      <textarea id="description" name="description" rows="3" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" placeholder="Kasallik belgilari va holatini tasvirlang..."><%= illness.description || '' %></textarea>
    </div>

    <div>
      <label for="prescribed_meds" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">Buyurilgan dorilar</label>
      <textarea id="prescribed_meds" name="prescribed_meds" rows="3" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm" placeholder="Dori nomi va dozalari..."><%= illness.prescribed_meds || '' %></textarea>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="status" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">Holat</label>
        <div class="relative">
          <select id="status" name="status" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm appearance-none cursor-pointer">
            <option value="Faol" class="bg-bg-sidebar text-text-main" <%= illness.status === 'Faol' ? 'selected' : '' %>>Faol</option>
            <option value="Davolanmoqda" class="bg-bg-sidebar text-text-main" <%= illness.status === 'Davolanmoqda' ? 'selected' : '' %>>Davolanmoqda</option>
            <option value="Tuzalgan" class="bg-bg-sidebar text-text-main" <%= illness.status === 'Tuzalgan' ? 'selected' : '' %>>Tuzalgan</option>
          </select>
          <span class="absolute right-4 top-1/2 -translate-y-1/2 text-text-muted pointer-events-none text-xs">▼</span>
        </div>
      </div>
      
      <div>
        <label for="diagnosed_date" class="text-xs uppercase tracking-wider text-text-muted font-bold mb-2 block">Tashxis sanasi</label>
        <input type="date" id="diagnosed_date" name="diagnosed_date" class="w-full bg-bg-page border border-border-main rounded-xl px-4 py-3 text-text-main placeholder-text-muted focus:outline-none focus:border-gold-primary focus:ring-1 focus:ring-gold-primary transition-all text-sm [color-scheme:light] dark:[color-scheme:dark]" value="<%= illness.diagnosed_date %>">
      </div>
    </div>

    <div class="flex items-center gap-3 pt-4 border-t border-border-main">
      <button type="submit" class="px-6 py-3 rounded-xl bg-gradient-to-r from-gold-primary to-gold-secondary text-white dark:text-black font-bold transition-all duration-300 shadow-md shadow-gold-primary/10 hover:shadow-lg hover:shadow-gold-primary/20 cursor-pointer text-sm btn-premium">
        💾 Saqlash
      </button>
      <a href="/illnesses" class="px-6 py-3 rounded-xl bg-bg-page border border-border-main hover:bg-bg-card-hover text-text-main font-semibold transition-all text-sm cursor-pointer btn-premium">
        Bekor qilish
      </a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
